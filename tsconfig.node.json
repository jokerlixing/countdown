{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "outDir": "out",
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "electron.vite.config.ts", "scripts/**/*.mjs"]
}
